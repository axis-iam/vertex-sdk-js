{
  "name": "@axis-iam/vertex-react",
  "version": "0.1.0",
  "description": "IAM React SDK — pre-built auth components, RBAC controls, and security hooks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.7",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@axis-iam/vertex": "workspace:0.1.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axis-iam/vertex": "workspace:0.1.0",
    "@testing-library/react": "^16.0.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "iam",
    "auth",
    "react",
    "rbac",
    "permissions",
    "components"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axis-iam/vertex-sdk-js",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/axis-iam/vertex-sdk-js#readme",
  "bugs": {
    "url": "https://github.com/axis-iam/vertex-sdk-js/issues"
  }
}
