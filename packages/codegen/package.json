{
  "name": "@axis-iam/vertex-codegen",
  "version": "0.1.0",
  "description": "Manifest-first local permission constants generator and explicit publication CLI",
  "type": "module",
  "bin": {
    "vertex-codegen": "./bin/vertex-codegen.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axis-iam/vertex": "workspace:0.1.0",
    "@humanwhocodes/momoa": "3.3.10",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "iam",
    "codegen",
    "permissions",
    "cli"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axis-iam/vertex-sdk-js",
    "directory": "packages/codegen"
  },
  "homepage": "https://github.com/axis-iam/vertex-sdk-js#readme",
  "bugs": { "url": "https://github.com/axis-iam/vertex-sdk-js/issues" }
}
