{
  "name": "@axis-iam/vertex-express",
  "version": "0.1.0",
  "description": "IAM Express middleware — JWT auth + RBAC permission checking",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "@axis-iam/vertex": "workspace:0.1.0"
  },
  "devDependencies": {
    "@axis-iam/vertex": "workspace:0.1.0",
    "@types/express": "^5.0.0",
    "express": "^5.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  },
  "keywords": ["iam", "express", "middleware", "auth", "rbac"],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/axis-iam/vertex-sdk-js",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/axis-iam/vertex-sdk-js#readme",
  "bugs": { "url": "https://github.com/axis-iam/vertex-sdk-js/issues" }
}
