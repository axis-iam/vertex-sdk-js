# Copy to .env.local for local Vite runs.
#
# Public SPA ApplicationClient.clientId from Portal/Admin.
# This is not the business Application UUID.
VITE_IAM_CLIENT_ID=iam_spa_public_client_id

# Java IAM issuer root. Local iam-server defaults to http://localhost:30001.
VITE_IAM_ISSUER_URI=http://localhost:30001

# Must exactly match one redirect URI on the SPA public ApplicationClient.
VITE_IAM_REDIRECT_URI=http://localhost:5173/callback

# Protected API half from sdk-java/examples/spring-boot-demo.
VITE_API_BASE_URL=http://localhost:8080
